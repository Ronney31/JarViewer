# JarViewer - Main .gitignore

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Docker volumes
docker-volumes/

# Other folder (unnecessary files)
other/

# Backup files
*.bak
*.backup
*.orig

# Archive files (except for test samples)
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# JAR files (uploaded for analysis)
uploads/
*.jar

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# PNPM store (global and local)
.pnpm-store/
frontend/.pnpm-store/
frontend/.pnpm-store/.*
backend/.pnpm-store/

# Frontend build outputs
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/

# Frontend cache and temporary files
frontend/.cache/
frontend/.parcel-cache/
frontend/.vite/
frontend/.turbo/

# Package manager lock files (keep one, ignore others)
frontend/yarn.lock
# frontend/package-lock.json  # Keep this one
# frontend/pnpm-lock.yaml     # Keep this one

# Frontend environment files
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Frontend testing
frontend/coverage/
frontend/.nyc_output/
frontend/test-results/
frontend/playwright-report/

# Coverage reports
coverage/
*.lcov

# Documentation build
docs/_build/
site/

# Python cache and build files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python virtual environments
.venv/
venv/
ENV/
env/
.env/

# Python testing
.pytest_cache/
.tox/
.coverage
htmlcov/
.coverage.*

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# pipenv
Pipfile.lock

# Poetry
poetry.lock

# Database files
*.db
*.sqlite
*.sqlite3

# Redis dump
dump.rdb

# Elasticsearch
elasticsearch/

# Docker
.dockerignore
docker-compose.override.yml

# Kubernetes
*.kubeconfig

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Monitoring and metrics
prometheus_data/
grafana_data/

.tempTestJar/